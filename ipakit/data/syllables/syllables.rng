<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start><ref name="language" /></start>
  <define name="language">
    <element name="syllabification">
      <attribute name="language"><text /></attribute>
      <attribute name="version"><data type="positiveInteger" /></attribute>
      <attribute name="mode"><data type="token"><param name="minLength">1</param></data></attribute>
      <attribute name="provenance"><text /></attribute>
      <oneOrMore>
        <choice>
          <element name="nucleus"><attribute name="span"><text /></attribute><empty /></element>
          <element name="onset">
            <attribute name="span"><text /></attribute>
            <choice>
              <group>
                <attribute name="stratum"><data type="token"><param name="minLength">1</param></data></attribute>
                <attribute name="harvested-count"><data type="nonNegativeInteger" /></attribute>
                <attribute name="curation-provenance"><data type="token"><param name="minLength">1</param></data></attribute>
                <optional><attribute name="exemplar"><text /></attribute></optional>
                <optional><attribute name="decision"><text /></attribute></optional>
              </group>
              <group>
                <optional><attribute name="harvested-count"><data type="nonNegativeInteger" /></attribute></optional>
                <optional><attribute name="exemplar"><text /></attribute></optional>
                <optional><attribute name="decision"><text /></attribute></optional>
                <optional><attribute name="curation-provenance"><text /></attribute></optional>
              </group>
            </choice>
            <empty />
          </element>
          <element name="coda"><attribute name="span"><text /></attribute><empty /></element>
          <element name="mora"><attribute name="span"><text /></attribute><empty /></element>
          <element name="inventory"><attribute name="source"><text /></attribute><empty /></element>
          <element name="syllable"><attribute name="ipa"><text /></attribute><optional><attribute name="spelling"><text /></attribute></optional><empty /></element>
        </choice>
      </oneOrMore>
    </element>
  </define>
</grammar>
