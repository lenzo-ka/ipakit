      <point arc="0.66" x="0.4903" y="0.8468" diameter="0.045" provenance="hand-placed"/>
      <point arc="0.78" x="0.5835" y="0.8147" diameter="0.043" provenance="hand-placed"/>
      <point arc="0.88" x="0.6454" y="0.7698" diameter="0.04" provenance="hand-placed"/>
      <point arc="0.95" x="0.6717" y="0.7337" diameter="0.038" provenance="hand-placed"/>
      <point arc="1.00" x="0.6797" y="0.6965" diameter="0.036" provenance="hand-placed"/>
    </nasal>
    <!-- Maxillary teeth. The incisal edge is the labiodental target
         (docs/tract-anatomy.md 3); the arch line runs back from it to
         the alveolar ridge. Hand-placed on the upper boundary: no
         instrument in docs/articulatory-data.md images the dentition. -->
    <teeth provenance="hand-placed">
