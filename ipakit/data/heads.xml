      <point arc="0.11" x="0.190" y="0.754" provenance="measured"/>
      <point arc="0.13" x="0.216" y="0.770" provenance="measured"/>
      <point arc="0.15" x="0.237" y="0.790" provenance="measured"/>
      <point arc="0.19" x="0.275" y="0.825" provenance="measured"/>
