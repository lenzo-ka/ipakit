      <point arc="0.5148" x="0.3385" y="0.9138" diameter="0.048" provenance="hand-placed"/>
      <point arc="0.6654" x="0.4443" y="0.8855" diameter="0.046" provenance="hand-placed"/>
      <point arc="0.7814" x="0.5197" y="0.8475" diameter="0.044" provenance="hand-placed"/>
