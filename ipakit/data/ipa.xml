      <value name="breathy" label="breathy-released" short="brt" href="Breathy_voice"/>
      <value name="lateral" label="lateral-released" short="lrl" href="Lateral_release_(phonetics)"/>
      <value name="nasal" label="nasally-released" short="nrl" href="Nasal_release"/>
      <value name="no-audible" label="unreleased" short="nau" href="No_audible_release"/>
      <value name="glottal" label="glottalized" short="grl" href="Glottalization"/>  <!-- the glottal phase of a pre-glottalized stop: a phase, not the segment's own place -->
      <value name="schwa" label="schwa-released" short="srl" href="Schwa"/>  <!-- the schwa-coloured release of a stop: a phase, not the segment's own vowel quality -->
    </feature>

    <feature name="rounding" short="rou" desc="Degree of lip rounding" href="Roundedness">
      <value name="less" short="les"/>
      <value name="more" short="mor"/>
    </feature>

    <feature name="phonation" axis="+glottal-aperture" short="phn" desc="Vocal fold vibration mode" href="Phonation">
      <value name="creaky" label="creaky-voiced" short="crk" href="Creaky_voice"/>
      <value name="modal" short="mod" href="Modal_voice"/>
      <value name="breathy" label="breathy-voiced" short="brv" href="Breathy_voice"/>
      <value name="devoiced" short="dev" href="Voicelessness"/>
    </feature>

    <!-- Suprasegmental multi-valued features -->
    <feature name="stress" short="str" mode="prosodic" desc="Prosodic prominence" href="Stress_(linguistics)">
      <value name="primary" short="1" href="Stress_(linguistics)"/>
      <value name="secondary" short="2" href="Secondary_stress"/>
    </feature>

    <feature name="tone" axis="+y" short="ton" mode="prosodic" desc="Pitch level" href="Tone_(linguistics)">
