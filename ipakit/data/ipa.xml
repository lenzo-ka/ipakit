<?xml version='1.0' encoding='utf-8'?>
<ipa version="1.1" wiki="https://en.wikipedia.org/wiki/">
  <types>
    <type name="binary" default="-">
      <value name="-"/>
      <value name="+"/>
    </type>
    <type name="ternary" default="0">
      <value name="-"/>
      <value name="0"/>
      <value name="+"/>
    </type>
  </types>

  <!-- Char classes define XML sections (plural) and child elements (singular = remove 's') -->
  <classes>
    <class name="phones"/>
    <class name="diacritics"/>
    <class name="suprasegmentals"/>
    <class name="separators"/>
  </classes>

  <!-- A diacritic's contribution mode is read off the features it declares
       (docs/ties.md): a mark is a release phase because it says release=,
       a secondary articulation because it says velarized=, and so on. No
       symbol is classified by its own name. Declaration order is
       precedence: the first mode any of the mark's keys claims wins. The
       mode named by `default` is what an undeclared feature contributes. -->
  <modes default="additive">
    <mode name="structural" desc="a juncture or boundary; belongs to no segment's feature bag"/>
    <mode name="prosodic" desc="belongs to the unit, not to its feature bag"/>
    <mode name="release" desc="names a phase of the segment, never the whole of it"/>
    <mode name="secondary" desc="a secondary articulation: adds a constriction, keeps the primary"/>
    <mode name="overriding" desc="replaces the base's value"/>
    <mode name="additive" desc="adds only what the base leaves unstated"/>
  </modes>

  <!-- Declaration order determines default feature_order -->
  <!-- Reference frame for ordinal scales: a left-facing oral tract.
       +x runs along the tract from the lips to the glottis (left to right
       in the standard sagittal diagram); +y runs jaw to palate (bottom to
       top); the minor z axis runs outward to the midline (laterality,
       centrality - binary here). Each multi-valued ordinal feature declares
       its axis, and its values ascend along it. Values marked offscale
       hold no position on the continuum (silence is not a degree of
       constriction); combining values (bilabial^velar) likewise hold no
       position. The combiner is "^", kept distinct from the "+" that is
       the positive value of a binary feature. -->
  <features>
    <feature name="manner" axis="+constriction" short="mnr" mode="overriding" desc="How airflow is constricted" href="Manner_of_articulation">
      <value name="silence" short="sil" offscale="+" href="Pause_(linguistics)"/>  <!-- no position: absence of signal, equidistant from every manner -->
      <value name="vowel" offset="0.40" short="vow" href="Vowel"/>
      <value name="approximant" offset="0.50" short="apr" href="Approximant"/>
      <value name="trill" offset="0.70" short="tri" href="Trill_consonant"/>
      <value name="tap" offset="0.75" short="tap" alias="flap" href="Tap_and_flap_consonants"/>
      <value name="nasal" offset="1.00" short="nas" href="Nasal_consonant"/>
      <value name="fricative" offset="0.80" short="fri" natural-class="obstruent" href="Fricative"/>
      <value name="plosive" offset="1.00" short="plo" alias="stop" natural-class="obstruent" href="Plosive"/>
      <value name="affricate" offset="0.95" short="aff" natural-class="obstruent" href="Affricate"/>
    </feature>

    <feature name="airstream" type="categorical" short="air" desc="Source of airflow" default="pulmonic" href="Airstream_mechanism">
      <value name="pulmonic" short="pul" href="Pulmonic_consonant"/>
      <value name="ejective" short="eje" href="Ejective_consonant"/>
      <value name="implosive" short="imp" href="Implosive_consonant"/>
      <value name="velaric" short="vel" href="Click_consonant"/>  <!-- velaric ingressive: the click airstream -->
    </feature>

    <feature name="place" axis="+x" short="plc" mode="overriding" desc="Where articulation occurs" href="Place_of_articulation">
      <value name="bilabial" arc="0.00" articulator="lower-lip" short="bil" href="Bilabial_consonant"/>
      <value name="labiodental" arc="0.03" articulator="lower-lip" short="lbd" href="Labiodental_consonant"/>
      <value name="dental" arc="0.08" articulator="tongue-tip" short="den" href="Dental_consonant"/>
      <value name="alveolar" arc="0.13" articulator="tongue-tip" short="alv" href="Alveolar_consonant"/>
      <value name="postalveolar" arc="0.19" articulator="tongue-blade" short="pav" href="Postalveolar_consonant"/>
      <value name="alveolo-palatal" arc="0.24" articulator="tongue-blade" short="apl" href="Alveolo-palatal_consonant"/>
      <value name="palatal" arc="0.32" articulator="tongue-front" short="pal" href="Palatal_consonant"/>
      <value name="bilabial^palatal" short="lpl" alias="labial-palatal" href="Labial%E2%80%93palatal_approximant"/>
      <value name="velar" arc="0.45" articulator="tongue-dorsum" short="vel" href="Velar_consonant"/>
      <value name="bilabial^velar" short="lbv" alias="labial-velar" href="Labial%E2%80%93velar_consonant"/>
      <value name="uvular" arc="0.56" articulator="tongue-dorsum" short="uvu" href="Uvular_consonant"/>
      <value name="pharyngeal" arc="0.74" articulator="tongue-root" short="pha" href="Pharyngeal_consonant"/>
      <value name="epiglottal" arc="0.87" articulator="epiglottis" short="epi" href="Epiglottal_consonant"/>
      <value name="glottal" arc="1.00" articulator="vocal-folds" short="glo" href="Glottal_consonant"/>
    </feature>

    <feature name="height" axis="+y" short="hgt" desc="Vertical tongue position for vowels" href="Vowel#Height">
      <value name="open" offset="0.05" short="opn" alias="low" href="Open_vowel"/>
      <value name="near-open" offset="0.10" short="nop" href="Near-open_vowel"/>
      <value name="open-mid" offset="0.16" short="opm" href="Open-mid_vowel"/>
      <value name="mid" offset="0.22" short="mid" href="Mid_vowel"/>
      <value name="close-mid" offset="0.28" short="clm" href="Close-mid_vowel"/>
      <value name="near-close" offset="0.33" short="ncl" href="Near-close_vowel"/>
      <value name="close" offset="0.38" short="clo" alias="high" href="Close_vowel"/>
    </feature>

    <feature name="backness" axis="+x" short="bck" desc="Horizontal tongue position for vowels" href="Vowel#Backness">
      <value name="front" arc="0.32" articulator="tongue-dorsum" short="frt" href="Front_vowel"/>
      <value name="near-front" arc="0.37" articulator="tongue-dorsum" short="nfr" href="Near-front_vowel"/>
      <value name="central" arc="0.44" articulator="tongue-dorsum" short="cen" href="Central_vowel"/>
      <value name="near-back" arc="0.50" articulator="tongue-dorsum" short="nbk" href="Near-back_vowel"/>
      <value name="back" arc="0.56" articulator="tongue-dorsum" short="bck" href="Back_vowel"/>
    </feature>

    <feature name="voiced" short="voi" type="binary" mode="overriding" desc="Vocal cord vibration" href="Voice_(phonetics)">
      <value name="+" label="voiced"/>
      <value name="-" label="voiceless"/>
    </feature>
    <feature name="rounded" short="rnd" type="binary" desc="Lip rounding" href="Roundedness">
      <value name="+" label="rounded"/>
      <value name="-" label="unrounded"/>
    </feature>
    <feature name="channel" axis="+z" short="chn" default="flat" applies="consonant" desc="Where the airflow channel sits in cross-section: the mid-sagittal plane projects this axis away, so it has no contour, only an ordering" href="Sibilant">
      <value name="lateral" short="lat" label="lateral" href="Lateral_consonant"/>  <!-- out: airflow at the sides, midline occluded -->
      <value name="flat" short="flt" href="Fricative"/>  <!-- diffuse central airflow -->
      <value name="grooved" short="grv" alias="sibilant" label="sibilant" href="Sibilant"/>  <!-- in: concentrated central jet -->
    </feature>
    <feature name="retroflex" short="rtf" type="binary" applies="consonant" desc="Tongue tip curled back" href="Retroflex_consonant">
      <value name="+" label="retroflex"/>
    </feature>
    <feature name="velarized" short="vlz" type="binary" mode="secondary" place="velar" desc="Secondary velar constriction" href="Velarization">
      <value name="+" label="velarized"/>
    </feature>
    <feature name="nasalized" short="nsl" type="binary" desc="Air flows through nose" href="Nasalization">
      <value name="+" label="nasalized"/>
    </feature>
    <feature name="length" axis="+t" short="len" mode="prosodic" desc="Segment duration" default="normal" href="Length_(phonetics)">
