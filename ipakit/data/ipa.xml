      <value name="fall" short="gF"/>
    </feature>

    <!-- Separator features -->
    <feature name="level" short="lvl" desc="Boundary level" href="Syllable">
      <value name="syllable" short="slb" href="Syllable"/>
      <value name="word" short="wrd" href="Word"/>
    </feature>
  </features>

  <!-- One phonetic dimension, spelled several ways. Nasality is a manner
       for one segment, a property of another and a release phase of a
       third, and per-feature comparison cannot see that those are the same
       thing: without this, a nasalized vowel and a nasal share no key
       expressing nasality at all. The metric derives one binary per bridge
       (docs/distance.md). The equivalence is a fact about the phonetics;
       what the metric does with it is not. -->
  <bridges>
    <bridge name="nasality" desc="Airflow through the nose" href="Nasalization">
      <spelling feature="manner" value="nasal"/>
      <spelling feature="nasalized" value="+"/>
      <spelling feature="release" value="nasal"/>
    </bridge>
    <bridge name="laterality" desc="Airflow at the sides of the tongue" href="Lateral_consonant">
      <spelling feature="channel" value="lateral"/>
      <spelling feature="release" value="lateral"/>
    </bridge>
  </bridges>

