<?xml version="1.0" encoding="utf-8"?>
<!-- The shape of heads.xml: mid-sagittal vocal-tract geometries, one per
     head, read by ipakit.tract and drawn by ipakit.tract_svg.

     This file describes geometry rather than inventory, so unlike the
     grammar beside ipa.xml it can afford to name every attribute it admits:
     a head has a midline, an optional measured roof outline, a nasal branch,
     teeth, a velum body, a carriage profile, a tongue body and a rest posture, and that
     list is the anatomy the model knows. Another part would be a new kind of
     declaration and belongs here. What it still does not name is vocabulary — `provenance`,
     `carrier`, `lips`, `velum` are left as text, because how a coordinate
     was arrived at and which rigid body carries it are facts the model
     states, not shapes this grammar should be able to veto.

     Every coordinate is normalized: x and y are fractions of the drawing
     box, arc runs 0 at the lips to 1 at the glottis, diameter is a fraction
     of the same box, and the jaw carriage is a fraction of variance. All of
     them are pinned to [0,1], which is the whole content of "normalized" —
     a coordinate outside it is not a head shape drawn oddly, it is a
     coordinate that was never in the space the renderer projects from.
     `length-cm` is the one dimensioned number here and is only required to
     be positive.

     Order among the parts is not significant: the reader finds each by
     name. Order WITHIN midline, nasal, carriage and teeth is significant —
     the points are a polyline and interpolation walks them in file order —
     and that is content order, which RELAX NG preserves without being
     asked. -->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <element name="heads">
      <!-- Which head answers `head()` with no argument. Required: a heads
           file that names no default cannot answer the question every
           caller who does not care about anatomy is asking. -->
      <attribute name="default"><text/></attribute>
      <ref name="landmarks"/>
      <oneOrMore>
        <element name="head">
          <attribute name="name"><text/></attribute>
          <optional><attribute name="desc"><text/></attribute></optional>
          <!-- Tract length from glottis to lips. Optional because the model
               carries it as absent rather than as a stand-in value: a head
               that has not been sized is a different thing from one sized
               at zero. -->
          <optional>
            <attribute name="length-cm">
              <data type="decimal">
                <param name="minExclusive">0</param>
              </data>
            </attribute>
          </optional>
          <interleave>
            <ref name="rest"/>
            <ref name="midline"/>
            <optional><ref name="roof"/></optional>
            <ref name="nasal"/>
            <ref name="velum"/>
            <ref name="teeth"/>
            <ref name="hinge"/>
            <ref name="carriage"/>
            <ref name="tongue"/>
            <ref name="epiglottis"/>
            <ref name="frontal"/>
          </interleave>
        </element>
      </oneOrMore>
    </element>
  </start>

  <define name="landmarks">
    <element name="landmarks">
      <oneOrMore>
        <element name="landmark">
          <attribute name="name"><text/></attribute>
          <attribute name="arc"><ref name="normalized"/></attribute>
          <attribute name="provenance"><text/></attribute>
          <zeroOrMore>
            <element name="head">
              <attribute name="name"><text/></attribute>
              <attribute name="arc"><ref name="normalized"/></attribute>
            </element>
          </zeroOrMore>
        </element>
      </oneOrMore>
    </element>
  </define>

  <!-- All seven parts are required. `ipakit/tract.py` defaults each of them,
       which is what makes an incomplete head draw rather than raise, and
       that is exactly why the grammar insists: a head silently missing its
       carriage profile draws with no jaw carrying anything, which is a
       figure that is wrong rather than a figure that is absent. -->

  <define name="rest">
    <!-- Where the articulators sit when not speaking. Rendering geometry:
         an utterance starts and ends here, and silence has to be drawn
         somewhere even though it is featurally null. The mid-body arc and
         offset shape the body; tip-arc and tip-offset seat its anterior end. -->
    <element name="rest">
      <attribute name="arc"><ref name="normalized"/></attribute>
      <attribute name="offset"><ref name="normalized"/></attribute>
      <attribute name="tip-arc"><ref name="normalized"/></attribute>
      <attribute name="tip-offset"><ref name="normalized"/></attribute>
      <attribute name="lips"><text/></attribute>
      <attribute name="jaw"><text/></attribute>
      <attribute name="velum"><text/></attribute>
    </element>
  </define>

  <define name="midline">
    <element name="midline">
      <oneOrMore><ref name="tract-point"/></oneOrMore>
    </element>
  </define>

  <define name="nasal">
    <element name="nasal">
      <!-- Where on the oral arc the nasal branch couples. The branch has
           its own arc, 0 at the nostrils to 1 at the port. -->
      <attribute name="port"><ref name="normalized"/></attribute>
      <oneOrMore><ref name="tract-point"/></oneOrMore>
    </element>
  </define>

  <define name="roof">
    <!-- The measured hard-palate outline. Unlike diameter, this is an
         absolute drawing boundary: the aperture peak and the vault apex are
         different landmarks. Outside its declared span projection falls
         back to midline plus diameter. -->
    <element name="roof">
      <oneOrMore>
        <element name="point">
          <attribute name="arc"><ref name="normalized"/></attribute>
          <attribute name="x"><ref name="normalized"/></attribute>
          <attribute name="y"><ref name="normalized"/></attribute>
          <attribute name="provenance"><text/></attribute>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="velum">
    <!-- Soft-palate body in normalized head coordinates. The hinge is the
         hard-palate junction and lowered-arc is the velar boundary target;
         its free edge moves between there and the posterior port wall. -->
    <element name="velum">
      <attribute name="thickness"><ref name="normalized"/></attribute>
      <attribute name="hinge-arc"><ref name="normalized"/></attribute>
      <attribute name="lowered-landmark"><text/></attribute>
      <attribute name="provenance"><text/></attribute>
    </element>
  </define>

  <define name="tract-point">
    <element name="point">
      <attribute name="arc"><ref name="normalized"/></attribute>
      <attribute name="x"><ref name="normalized"/></attribute>
      <attribute name="y"><ref name="normalized"/></attribute>
      <attribute name="diameter"><ref name="normalized"/></attribute>
      <!-- Per point rather than per section, because the midline mixes
           measured and extrapolated diameters and the distinction is the
           point of docs/articulatory-data.md. Where a whole part has one
           provenance it is stated once, on the part. -->
      <attribute name="provenance"><text/></attribute>
    </element>
  </define>

  <define name="teeth">
    <element name="teeth">
      <attribute name="provenance"><text/></attribute>
      <oneOrMore>
        <element name="point">
          <attribute name="name"><text/></attribute>
          <attribute name="x"><ref name="normalized"/></attribute>
          <attribute name="y"><ref name="normalized"/></attribute>
          <!-- Which rigid body the tooth rides on. Mandibular coordinates
               are the rest posture and move with the jaw; skull ones do
               not. -->
          <attribute name="carrier"><text/></attribute>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="carriage">
    <element name="carriage">
      <attribute name="provenance"><text/></attribute>
      <oneOrMore>
        <element name="point">
          <attribute name="arc"><ref name="normalized"/></attribute>
          <!-- The fraction of positional variance at this arc that the jaw
               accounts for, so a fraction and not a position. -->
          <attribute name="jaw"><ref name="normalized"/></attribute>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="hinge">
    <!-- Fixed temporomandibular pivot in the head's sagittal coordinates.
         `rotation` is the signed angle, in degrees, from the fully open
         declaration to full jaw closure. -->
    <element name="hinge">
      <attribute name="x"><ref name="normalized"/></attribute>
      <attribute name="y"><ref name="normalized"/></attribute>
      <attribute name="rotation"><data type="decimal"/></attribute>
      <attribute name="provenance"><text/></attribute>
    </element>
  </define>

  <define name="tongue">
    <!-- One body: `from` and `to` bound the arc range its surface spans,
         `falloff` is the half-width of the raised cosine in arc, and
         `taper` is how far from each end the surface descends to the
         floor. All four are arc distances, so all four are normalized. -->
    <element name="tongue">
      <!-- The anterior endpoint is a separately named mandibular attachment,
           rather than an implication of the carriage profile. -->
      <attribute name="attachment"><ref name="normalized"/></attribute>
      <!-- The rigid body carrying that attachment. Genioglossus originates
           on the mandible, so this declaration overrides soft-tissue
           carriage membership at the endpoint. -->
      <attribute name="carrier"><text/></attribute>
      <attribute name="from"><ref name="normalized"/></attribute>
      <attribute name="to"><ref name="normalized"/></attribute>
      <attribute name="falloff"><ref name="normalized"/></attribute>
      <attribute name="taper"><ref name="normalized"/></attribute>
      <attribute name="closure-threshold"><ref name="normalized"/></attribute>
      <attribute name="tip"><ref name="normalized"/></attribute>
      <attribute name="provenance"><text/></attribute>
    </element>
  </define>

  <define name="epiglottis">
    <!-- The leaf is rooted in the larynx, with a free tip beside the tongue
         root. It approaches the epiglottal wall target as its posture degree
         rises; tongue-coupling is the simultaneous tongue-root contribution. -->
    <element name="epiglottis">
      <attribute name="attachment"><ref name="normalized"/></attribute>
      <attribute name="rest-arc"><ref name="normalized"/></attribute>
      <attribute name="target-arc"><ref name="normalized"/></attribute>
      <attribute name="rest-offset"><ref name="normalized"/></attribute>
      <attribute name="thickness"><ref name="normalized"/></attribute>
      <attribute name="tongue-coupling"><ref name="normalized"/></attribute>
      <attribute name="provenance"><text/></attribute>
    </element>
  </define>

  <define name="frontal">
    <!-- Face-on shape remains on Head. Arc is the declared painter depth;
         carrier says whether jaw drop moves the contour. -->
    <element name="frontal">
      <oneOrMore>
        <element name="contour">
          <attribute name="name"><text/></attribute>
          <attribute name="carrier"><text/></attribute>
          <attribute name="arc"><ref name="normalized"/></attribute>
          <attribute name="provenance"><text/></attribute>
          <oneOrMore>
            <element name="point">
              <attribute name="x"><ref name="normalized"/></attribute>
              <attribute name="y"><ref name="normalized"/></attribute>
            </element>
          </oneOrMore>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="normalized">
    <data type="decimal">
      <param name="minInclusive">0</param>
      <param name="maxInclusive">1</param>
    </data>
  </define>

</grammar>
